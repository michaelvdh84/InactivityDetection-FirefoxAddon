{
    "manifest_version": 3,
    "name": "Inactivity Detection",
    "version": "2.5.3",
    "description": "Check inactivity, clear browsing data, and redirect after a certain time.",
    "icons": {
      "48": "icons/hibernation-48.png",
      "96": "icons/hibernation-96.png"

    },
    "browser_specific_settings": {
      "gecko": {
        "id": "michael.vanderhoudelinghen@i-city.brucity.be",
        "data_collection_permissions": {
          "required": ["none"]
        }
      }
    },
    "permissions": [
      "activeTab",
      "browsingData",
      "nativeMessaging",
      "tabs",
      "storage"
    ],

    "background": {
      "scripts": ["background.js"]
    },

    "action": {
      "default_icon":"icons/hibernation-48.png",
      "default_title":"Inactivity Options",
      "default_popup":"popup/options.html"
    },

    "content_scripts": [
      {
      "matches": ["<all_urls>"],
      "js": ["timeoutModal.js"],
      "css":["inactivityplugin.css"]
      }
    ]
  }
